# ---------------------------------------------------------------------------
# Testigo — copy to .env and fill in. Nothing here is a real secret in demo mode.
# ---------------------------------------------------------------------------

PORT=3400

# DEMO_MODE=1 runs the whole pipeline with a simulated chain and the deterministic
# rules engine. Everything works with zero setup — use it to rehearse the demo.
# Set to 0 once WDK + QVAC are wired and you want the real path.
DEMO_MODE=1

# --- WDK -------------------------------------------------------------------
# Generate one with: npm run wallet:new
# This is the PARTY's self-custodial donation wallet. Testnet only, never commit.
WDK_SEED_PHRASE=

# Which chain the demo wallet lives on.
WDK_CHAIN=ethereum
WDK_NETWORK=sepolia
WDK_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# The ERC-20 a party accepts. USD₮ on Sepolia below — this is Tether's own
# stablecoin, which is what WDK is built around. Aave's public faucet mints it:
# https://app.aave.com/faucet/  (select Ethereum Sepolia, then USDT)
#
# Swapping this address for USDC, or for mainnet, needs no code change at all:
# the WDK path is identical for any ERC-20.
WDK_TOKEN_SYMBOL=USDT
WDK_TOKEN_ADDRESS=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0
WDK_TOKEN_DECIMALS=6

# How often the indexer polls for incoming donations (ms).
INDEXER_POLL_MS=15000

# --- QVAC ------------------------------------------------------------------
# Model constant exported by @qvac/sdk. LLAMA_3_2_1B_INST_Q4_0 is the smallest
# instruct model — fastest download, which matters on venue wifi.
# Pull the weights BEFORE you need them: npm run qvac:pull
# (~2.4 GB, cached in ~/.qvac — not in this repo)
#
# Do NOT drop to LLAMA_3_2_1B_INST_Q4_0 to save the download. We tested it: the
# 1B model reliably inverted the verdict it was asked to restate, writing
# "donante extranjero (US) no rechazada" for a non-compliant donation. The
# contradiction guard in qvac-agent.ts catches it and falls back to the rules
# engine, so nothing breaks — you just lose the rationale on every row.
QVAC_MODEL=QWEN3_4B_INST_Q4_K_M

# --- Compliance policy -----------------------------------------------------
# Jurisdiction whose rules we enforce.
COMPLIANCE_COUNTRY=CR

# Annual per-donor cap, in USD equivalent.
# PLACEHOLDER — confirm the real figure against the Codigo Electoral before any
# claim is made to the TSE. It is a demo threshold, not legal advice.
COMPLIANCE_DONOR_CAP_USD=25000

# Hours a donation may sit without a valid attestation before it is flagged
# for return.
COMPLIANCE_CURE_WINDOW_HOURS=72

# ---------------------------------------------------------------------------
# Velar Audit — copy to .env and fill in.
#
# This system has no simulated mode. It reads and writes a real chain, so it
# needs a real wallet and a funded one. Nothing here belongs in version control.
# ---------------------------------------------------------------------------

PORT=3400

# --- Party wallets ---------------------------------------------------------
# Generate with: npm run wallet:new
# Every party's donation wallet is derived from this one phrase at a different
# account index, so a deployment covering many parties needs one seed, not one
# per party. Testnet only.
WDK_SEED_PHRASE=

# --- Chain -----------------------------------------------------------------
WDK_NETWORK=sepolia
WDK_CHAIN_ID=11155111
WDK_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Public endpoints rate-limit. A second one is cheap insurance mid-demonstration.
WDK_RPC_FALLBACK_URL=https://rpc.sepolia.org
WDK_EXPLORER_URL=https://sepolia.etherscan.io

# The ERC-20 a party accepts. USD₮ on Sepolia below — Tether's own stablecoin,
# which is what WDK is built around. Aave's public faucet mints it:
# https://app.aave.com/faucet/  (select Ethereum Sepolia, then USDT)
#
# Swapping this for USDC, or for mainnet, needs no code change: the WDK path is
# identical for any ERC-20.
WDK_TOKEN_SYMBOL=USDT
WDK_TOKEN_ADDRESS=0xaA8E23Fb1079EA71e0a56F48a2aA51851D8433D0
WDK_TOKEN_DECIMALS=6

# --- Indexer ---------------------------------------------------------------
INDEXER_POLL_MS=15000
# Where a cold start replays from. Set this to the block just before your first
# donation so state rebuilds from the chain instead of from disk. 0 starts just
# behind the tip.
INDEXER_START_BLOCK=0

# --- Evidence --------------------------------------------------------------
# Evidence is anchored in batches under one Merkle root. Anchoring each item on
# its own was measured at ~28 minutes for a seeding run, because transactions
# from one account serialise on nonce; batching brings that to seconds.
EVIDENCE_BATCH_SIZE=12
EVIDENCE_BATCH_MAX_AGE_SECONDS=20

# A serverless host has no background process, so requests drive the indexer.
# This is the floor between passes.
SYNC_MIN_INTERVAL_SECONDS=10

# --- Donor wallets (seeding only) ------------------------------------------
# Generate with: npm run donor:new, then fund account 0 from the faucets above
# and run: npm run seed:chain
DONOR_SEED_PHRASE=

# --- Local AI --------------------------------------------------------------
# Model constant exported by @qvac/sdk. Pull the weights before you need them:
# npm run qvac:pull  (~2.4 GB, cached in ~/.qvac, not in this repo)
#
# Do not drop to LLAMA_3_2_1B_INST_Q4_0 to save the download. It reliably
# inverted the verdict it was asked to restate, writing "foreign donor (US), not
# rejected" for a non-compliant donation.
QVAC_MODEL=QWEN3_4B_INST_Q4_K_M

# --- Compliance policy -----------------------------------------------------
COMPLIANCE_COUNTRY=CR

# Annual per-donor cap, in USD equivalent.
# PLACEHOLDER — confirm the real figure against the Codigo Electoral before any
# claim is made to the electoral tribunal. It is a demonstration threshold, not
# legal advice. Set below the seeding scenario's largest donor total so the rule
# actually fires.
COMPLIANCE_DONOR_CAP_USD=2500

# Hours a donation may sit without a valid attestation before it is flagged.
COMPLIANCE_CURE_WINDOW_HOURS=72

# Password for the seeded demonstration accounts.
DEMO_PASSWORD=velar-demo-2026

# --- Sessions --------------------------------------------------------------
# Signing key for the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Sessions are stateless: the cookie carries the claim and its own signature,
# and nothing is kept server-side. That is what lets a login survive on a
# serverless host, where every cold start begins with an empty store and a
# read-only disk. The cost is that all instances must sign with the same key —
# leave this blank on a multi-instance deployment and logins appear to expire at
# random, because the instance checking the cookie is not the one that issued it.
SESSION_SECRET=

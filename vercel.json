{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "installCommand": "npm install --omit=optional --omit=dev",
  "functions": {
    "api/index.ts": {
      "includeFiles": "node_modules/**/prebuilds/linux-x64/**"
    }
  }
}
